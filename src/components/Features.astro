---
import SectionLabel from './SectionLabel.astro';

const features = [
  { title: 'Przystępne zasady', desc: 'Ogarniasz w minutę, grasz od razu.' },
  { title: 'Wysoka regrywalność', desc: '210 kart — każda partia jest inna.' },
  { title: 'Humor', desc: 'Zwariowane role i mnóstwo śmiechu.' },
  { title: 'Zachęca do dyskusji', desc: 'Remis? Rozstrzyga burzliwa debata.' },
  { title: 'Szybka rozgrywka', desc: 'Idealna na rozkręcenie spotkania.' },
];
---

<section class="bg-[linear-gradient(160deg,#5a189a_0%,#8338d6_100%)] px-4 py-16 text-white">
  <div class="mx-auto max-w-3xl">
    <SectionLabel text="Co wyróżnia grę „Zrolowani”" class="text-white/75" />
    <ul class="mt-8 flex flex-col gap-4" data-pop="slide">
      {
        features.map((f) => (
          <li class="group flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-6">
            <h3 class="font-display bg-brand-800 self-start rounded-2xl px-5 py-3 text-base font-extrabold text-white shadow-lg shadow-black/20 motion-safe:transition motion-safe:duration-200 motion-safe:group-hover:-translate-y-1 motion-safe:group-hover:rotate-[-1.5deg] motion-safe:group-hover:shadow-xl motion-safe:group-hover:shadow-black/30 sm:w-60 sm:shrink-0 sm:self-auto sm:text-center">
              {f.title}
            </h3>
            <p class="text-white/85 motion-safe:transition motion-safe:duration-200 motion-safe:group-hover:text-white">
              {f.desc}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
