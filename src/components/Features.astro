---
import SectionLabel from './SectionLabel.astro';

const features = [
  { title: 'Przystępne zasady', desc: 'Ogarniasz w minutę, grasz od razu.' },
  { title: 'Wysoka regrywalność', desc: '210 kart — każda partia jest inna.' },
  { title: 'Humor', desc: 'Zwariowane role i mnóstwo śmiechu.' },
  { title: 'Zachęca do dyskusji', desc: 'Remis? Rozstrzyga burzliwa debata.' },
  { title: 'Szybka rozgrywka', desc: 'Idealna na rozkręcenie spotkania.' },
];
---

<section
  class="bg-[linear-gradient(160deg,#241046_0%,#3a1a6e_100%)] px-4 py-16 text-white"
>
  <div class="mx-auto max-w-3xl">
    <SectionLabel text="Co wyróżnia grę „Zrolowani”" class="text-brand-400" />
    <ul class="mt-8 divide-y divide-white/10">
      {
        features.map((f) => (
          <li class="flex flex-col gap-1 py-5 sm:flex-row sm:items-baseline sm:gap-8">
            <h3 class="font-display shrink-0 text-lg font-extrabold text-white sm:w-56">
              {f.title}
            </h3>
            <p class="text-white/70">{f.desc}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
