---
import logo from '../assets/logo.png';
import BuyButton from './BuyButton.astro';

const links = [
  { href: '#gra', label: 'Gra' },
  { href: '#zasady', label: 'Zasady' },
  { href: '#pudelko', label: 'Pudełko' },
];
---

<header data-nav class="fixed inset-x-0 top-0 z-50 transition-colors duration-300">
  <nav class="mx-auto flex max-w-6xl items-center gap-4 px-4 py-3" aria-label="Główna">
    <a
      href="#top"
      class="nav-logo flex shrink-0 items-center"
      aria-label="Zrolowani — strona główna"
    >
      <img
        src={logo.src}
        width={logo.width}
        height={logo.height}
        alt="Zrolowani"
        class="h-7 w-auto"
      />
    </a>

    <div class="hidden flex-1 items-center justify-evenly md:flex">
      <span data-nav-sep aria-hidden="true" class="h-4 w-px bg-white/60"></span>
      {
        links.map((l) => (
          <>
            <a href={l.href} class="text-sm text-white/70 transition hover:text-white">
              {l.label}
            </a>
            <span data-nav-sep aria-hidden="true" class="h-4 w-px bg-white/60" />
          </>
        ))
      }
    </div>

    <div class="hidden shrink-0 md:block">
      <BuyButton class="!px-5 !py-2 text-sm" />
    </div>

    <button
      data-nav-toggle
      type="button"
      class="ml-auto text-white md:hidden"
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label="Otwórz menu"
    >
      <span class="block h-0.5 w-6 bg-white"></span>
      <span class="mt-1.5 block h-0.5 w-6 bg-white"></span>
      <span class="mt-1.5 block h-0.5 w-6 bg-white"></span>
    </button>
  </nav>

  <div
    id="nav-menu"
    data-nav-menu
    hidden
    class="bg-brand-950/95 border-t border-white/10 px-4 py-4 md:hidden"
  >
    <div class="flex flex-col gap-3">
      {
        links.map((l) => (
          <a href={l.href} class="text-white/80" data-nav-link>
            {l.label}
          </a>
        ))
      }
      <BuyButton class="mt-2 w-full" />
    </div>
  </div>
</header>
